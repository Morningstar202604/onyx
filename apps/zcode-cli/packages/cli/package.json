{
  "name": "@onyx/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Main CLI application for onyx",
  "bin": {
    "onyx": "./dist/zcode.cjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/zcode.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop-agent": "node scripts/build.mjs --desktop-agent",
    "build:sea": "pnpm --dir ../../../.. exec turbo --skip-infer --cwd apps/zcode-cli run build --filter=!@onyx/cli --force && pnpm build && node scripts/build-sea.mjs --all",
    "sea": "node scripts/build-sea.mjs",
    "upload:sea": "node scripts/upload-sea-smb.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@onyx/adapters": "workspace:*",
    "@onyx/bootstrap": "workspace:*",
    "@onyx/contracts": "workspace:*",
    "@onyx/core": "workspace:*",
    "@onyx/dynamic-workflow-runtime": "workspace:*",
    "@onyx/i18n": "workspace:*",
    "@onyx/provider-node": "workspace:*",
    "@onyx/shared": "workspace:*",
    "@onyx/shared-types": "workspace:*",
    "@onyx/tui": "workspace:*",
    "dotenv": "^17.4.2",
    "playwright-core": "1.59.1"
  }
}
