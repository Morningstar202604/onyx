# Onyx 环境变量参考。按需复制到 .env；部署覆盖也可放在未跟踪的 .env.local 中。
# Onyx 不内置任何上游服务器地址；以下变量全部可选，未配置即禁用对应功能。

# 自建 API endpoint（仅当你有自己的后端服务时需要；普通自用无需配置）。
ZCODE_BASE_URL=
ZCODE_ENDPOINT_ORIGIN=

# 自建远程资源 CDN（桌面端 WSL/SSH/Docker 远程运行时的资源分发，可选）。
ZCODE_CDN_BASE_URL=
ZCODE_REMOTE_ASSET_CDN_BASE_URL=

# 会话分享功能需要自有后端；未配置即禁用（Onyx 默认无服务器）。
ZCODE_CONVERSATION_SHARE_WEB_URL=

# 可选本地 Provider 配置文件路径；留空使用随包内置配置。
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=

# 桌面自动更新需要自有更新源；未配置即禁用自动更新。
ZCODE_UPDATE_FEED_URL=

# 私有部署地址没有默认值，按需显式填写。
ZCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
ZCODE_DIST_BASE_URL=
